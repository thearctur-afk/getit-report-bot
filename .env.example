# Скопируйте этот файл в .env прямо на сервере PythonAnywhere (через вкладку
# Files) и заполните своими значениями. .env не должен попадать в GitHub —
# он уже добавлен в .gitignore.

# Токен бота, который выдал @BotFather
BOT_TOKEN=

# Ваш личный Telegram ID (узнать у @userinfobot)
ADMIN_ID=

# ID групп, куда бот будет слать сводки.
# Узнать ID: добавьте бота в группу и напишите там /chatid
# Если группы ещё нет — оставьте 0, бот её пропустит.
GROUP_1_ID=0
GROUP_2_ID=0
GROUP_3_ID=0

# Путь к файлу базы данных. На PythonAnywhere укажите полный путь вида
# /home/ваш_логин/partner_bot/partner_bot.db — так база будет храниться
# на постоянном диске и не потеряется при обновлении кода.
DB_PATH=partner_bot.db

# Длинная случайная строка — секретная часть адреса вебхука и триггеров.
# Придумайте свою (например, набор из 20+ случайных букв и цифр) и не
# показывайте её никому. Использовать один и тот же секрет в .env и в
# секретах GitHub Actions (WEBHOOK_SECRET).
WEBHOOK_SECRET=change_me_to_a_random_string

# Домен вашего приложения на PythonAnywhere, нужен только для set_webhook.py
# Пример: myusername.pythonanywhere.com
PA_DOMAIN=
