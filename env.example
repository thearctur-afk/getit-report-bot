# Скопируйте этот файл в .env и заполните своими значениями.
# На Railway эти же переменные задаются в разделе Variables проекта —
# отдельный .env файл там не нужен.

# Токен бота, который выдал @BotFather
BOT_TOKEN=

# Ваш личный Telegram ID (узнать у @userinfobot)
ADMIN_ID=

# ID групп, куда бот будет слать сводки.
# Узнать ID: добавьте бота в группу и напишите там /chatid
# Если группы ещё нет — оставьте 0, бот её пропустит.
GROUP_1_ID=0
GROUP_2_ID=0
GROUP_3_ID=0

# Путь к файлу базы данных (можно не менять)
DB_PATH=partner_bot.db
